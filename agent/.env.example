# Copy this file to .env and fill in the key locally. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PROVIDERS=baseten,deepinfra,fireworks,streamlake
# The list above is also sent as OpenRouter's strict provider.only allow-list.
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Retried only before any model-requested tool runs; this never retries a Tutu action.
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=0.5
OPENROUTER_MAX_RETRY_DELAY_SECONDS=8
# Speech-to-text via the same OpenRouter key. Not the chat provider allow-list.
OPENROUTER_STT_MODELS=openai/whisper-large-v3-turbo,google/chirp-3,openai/whisper-large-v3
OPENROUTER_STT_TIMEOUT_SECONDS=45
OPENROUTER_STT_MAX_AUDIO_BYTES=4000000
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
APP_HOST=127.0.0.1
APP_PORT=8000
AGENT_MAX_STEPS=20
